// nice!view: el adapter ya desactiva pro_micro_i2c (SSD1306). Solo queda
// bajar el SPI a 100kHz — workaround EMI de la mitad izquierda.
&pro_micro_i2c {
    status = "disabled";
};

&nice_view {
    spi-max-frequency = <100000>;
};
